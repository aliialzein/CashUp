generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// OWNER oversees the business.
// MANAGER runs operations.
// STAFF handles cashier/driver work.
// In a solo business, the OWNER performs all three functions.
enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum CashUpStatus {
  OPEN
  SUBMITTED
  APPROVED
  VOID
}

enum SaleStatus {
  TO_DELIVER
  DELIVERED
  DELETED
}

enum CashOutStatus {
  ACTIVE
  CANCELLED
}

enum Currency {
  USD
  LBP
}

enum PaymentMethod {
  CASH
  WHISH
  OMT
}

enum RequestType {
  DELETE_SALE
  VOID_CASHUP
}

enum RequestStatus {
  AWAITING_OWNER
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AmendmentStatus {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum AmendmentChangeKind {
  SALE_FIELD
  COUNT_ENTRY
}

enum AuditEntityType {
  USER
  BUSINESS
  MEMBERSHIP
  JOIN_CODE
  CASH_UP
  SALE
  CASH_OUT
  COUNT_ENTRY
  REQUEST
  AMENDMENT
}

enum AuditAction {
  BUSINESS_CREATED
  BUSINESS_SOLO_CHANGED
  JOIN_CODE_CREATED
  JOIN_CODE_REVOKED
  JOIN_CODE_USED
  MEMBER_JOINED
  MEMBER_DEACTIVATED
  MEMBER_REACTIVATED
  MEMBER_ROLE_CHANGED

  CASHUP_OPENED
  CASHUP_SUBMITTED
  CASHUP_APPROVED
  CASHUP_SELF_APPROVED
  CASHUP_RETURNED
  CASHUP_VOIDED

  SALE_CREATED
  SALE_EDITED
  SALE_DELIVERED
  SALE_CANCELLED
  SALE_LOCKED_FOR_DELETION
  SALE_DELETED

  CASHOUT_CREATED
  CASHOUT_CANCELLED
  CASHOUT_EDITED
  COUNT_UPDATED

  REQUEST_CREATED
  REQUEST_WITHDRAWN
  REQUEST_APPROVED
  REQUEST_REJECTED

  AMENDMENT_PROPOSED
  AMENDMENT_APPROVED
  AMENDMENT_REJECTED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String?
  fullName     String
  phone        String?
  provider     AuthProvider @default(LOCAL)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  memberships      Membership[]
  joinCodesCreated JoinCode[]           @relation("JoinCodeCreator")
  passwordResets   PasswordResetToken[]
  auditLogs        AuditLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Business {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  isSolo           Boolean  @default(false)
  lastCashUpNumber Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  joinCodes   JoinCode[]
  cashUps     CashUp[]
  sales       Sale[]
  requests    Request[]
  amendments  Amendment[]
  auditLogs   AuditLog[]

  @@map("businesses")
}

// One membership per user for the current MVP.
// One OWNER and one ACTIVE MANAGER per business are enforced
// through partial unique indexes in migrations.
model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  businessId    String           @db.Uuid
  role          MembershipRole
  status        MembershipStatus @default(ACTIVE)
  joinedAt      DateTime         @default(now()) @db.Timestamptz(3)
  deactivatedAt DateTime?        @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  cashUps            CashUp[]    @relation("CashUpOwnerOfWork")
  cashUpsApproved    CashUp[]    @relation("CashUpApprover")
  cashOutsCancelled  CashOut[]   @relation("CashOutCancelledBy")
  salesEdited        SaleEdit[]
  requestsMade       Request[]   @relation("RequestRequester")
  requestsDecided    Request[]   @relation("RequestDecider")
  amendmentsProposed Amendment[] @relation("AmendmentProposer")
  amendmentsDecided  Amendment[] @relation("AmendmentDecider")

  @@unique([userId])
  @@index([businessId, role])
  @@map("memberships")
}

// Staff-only for the MVP, enforced in the service.
// Codes expire, have a usage limit, and are stored as hashes.
model JoinCode {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  codeHash        String         @unique
  role            MembershipRole @default(STAFF)
  createdByUserId String         @db.Uuid
  expiresAt       DateTime       @db.Timestamptz(3)
  maxUses         Int
  usedCount       Int            @default(0)
  revokedAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy User     @relation("JoinCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@map("join_codes")
}

model CashUp {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  number       Int
  membershipId String       @db.Uuid
  status       CashUpStatus @default(OPEN)

  floatUsd      Decimal  @default(0) @db.Decimal(18, 2)
  floatLbp      Decimal  @default(0) @db.Decimal(18, 2)
  referenceRate Decimal? @db.Decimal(18, 2)

  openedAt       DateTime  @default(now()) @db.Timestamptz(3)
  countStartedAt DateTime? @db.Timestamptz(3)
  closedAt       DateTime? @db.Timestamptz(3)
  approvedAt     DateTime? @db.Timestamptz(3)
  voidedAt       DateTime? @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  // STAFF cash-ups: approved by MANAGER.
  // MANAGER cash-ups: approved by OWNER.
  // Solo businesses: self-approved.
  approvedById   String? @db.Uuid
  selfApproved   Boolean @default(false)
  returnReason   String?
  voidReason     String?
  lastSaleNumber Int     @default(0)

  // Snapshot calculated on submission, separately per currency.
  expectedUsd Decimal? @db.Decimal(18, 2)
  expectedLbp Decimal? @db.Decimal(18, 2)
  countedUsd  Decimal? @db.Decimal(18, 2)
  countedLbp  Decimal? @db.Decimal(18, 2)
  gapUsd      Decimal? @db.Decimal(18, 2)
  gapLbp      Decimal? @db.Decimal(18, 2)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership Membership  @relation("CashUpOwnerOfWork", fields: [membershipId], references: [id], onDelete: Restrict)
  approvedBy Membership? @relation("CashUpApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  sales        Sale[]
  cashOuts     CashOut[]
  countEntries CountEntry[]
  requests     Request[]
  amendments   Amendment[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([membershipId, status])
  @@index([businessId, openedAt])
  @@map("cash_ups")
}

model Sale {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  cashUpId   String @db.Uuid
  saleNumber Int

  status SaleStatus @default(DELIVERED)

  businessAmountUsd Decimal @default(0) @db.Decimal(18, 2)
  businessAmountLbp Decimal @default(0) @db.Decimal(18, 2)

  deliveryFeeUsd Decimal @default(0) @db.Decimal(18, 2)
  deliveryFeeLbp Decimal @default(0) @db.Decimal(18, 2)

  tipUsd Decimal @default(0) @db.Decimal(18, 2)
  tipLbp Decimal @default(0) @db.Decimal(18, 2)

  discountUsd Decimal @default(0) @db.Decimal(18, 2)
  discountLbp Decimal @default(0) @db.Decimal(18, 2)

  totalCollectedUsd Decimal @default(0) @db.Decimal(18, 2)
  totalCollectedLbp Decimal @default(0) @db.Decimal(18, 2)

  changeGivenUsd Decimal @default(0) @db.Decimal(18, 2)
  changeGivenLbp Decimal @default(0) @db.Decimal(18, 2)

  method       PaymentMethod
  clientNumber String?
  note         String?

  amountDiffers    Boolean @default(false)
  isEdited         Boolean @default(false)
  deletionAwaiting Boolean @default(false)

  cancelReason String?

  idempotencyKey String? @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp   CashUp   @relation(fields: [cashUpId], references: [id], onDelete: Restrict)

  edits            SaleEdit[]
  requests         Request[]
  amendmentChanges AmendmentChange[]

  @@unique([cashUpId, saleNumber])
  @@unique([businessId, idempotencyKey])
  @@index([cashUpId, status])
  @@index([businessId, clientNumber])
  @@map("sales")
}

// Records the old and new value of each edited field.
model SaleEdit {
  id         String   @id @default(uuid()) @db.Uuid
  saleId     String   @db.Uuid
  editedById String   @db.Uuid
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  sale     Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  editedBy Membership @relation(fields: [editedById], references: [id], onDelete: Restrict)

  @@index([saleId, createdAt])
  @@map("sale_edits")
}

model CashOut {
  id       String @id @default(uuid()) @db.Uuid
  cashUpId String @db.Uuid

  amountUsd Decimal @default(0) @db.Decimal(18, 2)
  amountLbp Decimal @default(0) @db.Decimal(18, 2)

  reason String
  note   String?

  status CashOutStatus @default(ACTIVE)

  cancelReason            String?
  cancelledAt             DateTime? @db.Timestamptz(3)
  cancelledByMembershipId String?   @db.Uuid

  idempotencyKey String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cashUp      CashUp      @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  cancelledBy Membership? @relation("CashOutCancelledBy", fields: [cancelledByMembershipId], references: [id], onDelete: Restrict)

  @@unique([cashUpId, idempotencyKey])
  @@index([cashUpId, status])
  @@map("cash_outs")
}

model CountEntry {
  id           String   @id @default(uuid()) @db.Uuid
  cashUpId     String   @db.Uuid
  currency     Currency
  denomination Decimal  @db.Decimal(18, 2)
  quantity     Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  cashUp           CashUp            @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  amendmentChanges AmendmentChange[]

  @@unique([cashUpId, currency, denomination])
  @@map("count_entries")
}

// Partial unique indexes enforce one awaiting request per target.
model Request {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  type          RequestType
  status        RequestStatus @default(AWAITING_OWNER)
  reason        String
  requestedById String        @db.Uuid

  // cashUpId is always required.
  // DELETE_SALE also requires saleId.
  // VOID_CASHUP must have saleId = null.
  saleId   String? @db.Uuid
  cashUpId String  @db.Uuid

  decidedById    String?   @db.Uuid
  decisionReason String?
  selfApproved   Boolean   @default(false)
  decidedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp      CashUp      @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy Membership  @relation("RequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   Membership? @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([cashUpId, status])
  @@map("requests")
}

model Amendment {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String          @db.Uuid
  cashUpId   String          @db.Uuid
  status     AmendmentStatus @default(AWAITING_APPROVAL)
  reason     String

  proposedById   String    @db.Uuid
  decidedById    String?   @db.Uuid
  decisionReason String?
  selfApproved   Boolean   @default(false)
  decidedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp     CashUp      @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  proposedBy Membership  @relation("AmendmentProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy  Membership? @relation("AmendmentDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  changes AmendmentChange[]

  @@index([businessId, status])
  @@index([cashUpId])
  @@map("amendments")
}

// One amendment can change several sale fields and counted quantities.
model AmendmentChange {
  id          String              @id @default(uuid()) @db.Uuid
  amendmentId String              @db.Uuid
  kind        AmendmentChangeKind

  saleId   String? @db.Uuid
  field    String?
  oldValue String?
  newValue String?

  countEntryId String? @db.Uuid
  oldQuantity  Int?
  newQuantity  Int?

  amendment  Amendment   @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  countEntry CountEntry? @relation(fields: [countEntryId], references: [id], onDelete: Restrict)

  @@index([amendmentId])
  @@map("amendment_changes")
}

// Append-only behavior is enforced through a database migration.
model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String?         @db.Uuid
  actorId    String?         @db.Uuid
  action     AuditAction
  entityType AuditEntityType
  entityId   String          @db.Uuid
  metadata   Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
