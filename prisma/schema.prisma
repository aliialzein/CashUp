generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MembershipRole {
  OWNER
  STAFF
}

enum CashUpStatus {
  OPEN
  SUBMITTED
  APPROVED
  VOID
}

enum SaleStatus {
  TO_DELIVER
  DELIVERED
  DELETED
}

enum Currency {
  USD
  LBP
}

enum PaymentMethod {
  CASH
  WHISH
  OMT
}

enum RequestType {
  DELETE_SALE
  VOID_CASHUP
  Amendment
}

enum RequestStatus {
  AWAITING_OWNER
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AmendmentStatus {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum AmendmentChangeKind {
  SALE_FIELD
  COUNT_ENTRY
}

enum AuditEntityType {
  USER
  BUSINESS
  MEMBERSHIP
  JOIN_CODE
  CASH_UP
  SALE
  CASH_OUT
  COUNT_ENTRY
  REQUEST
  AMENDMENT
}

enum AuditAction {
  // access
  BUSINESS_CREATED
  JOIN_CODE_CREATED
  JOIN_CODE_REVOKED
  JOIN_CODE_USED
  MEMBER_JOINED
  MEMBER_DEACTIVATED
  MEMBER_REACTIVATED
  // cash-up lifecycle
  CASHUP_OPENED
  CASHUP_SUBMITTED
  CASHUP_APPROVED
  CASHUP_SELF_APPROVED
  CASHUP_RETURNED
  CASHUP_VOIDED
  // sales
  SALE_CREATED
  SALE_EDITED
  SALE_DELIVERED
  SALE_CANCELLED
  SALE_LOCKED_FOR_DELETION
  SALE_DELETED
  // cash-outs & counts
  CASHOUT_CREATED
  CASHOUT_EDITED
  COUNT_UPDATED
  // requests
  REQUEST_CREATED
  REQUEST_WITHDRAWN
  REQUEST_APPROVED
  REQUEST_REJECTED
  // amendments
  AMENDMENT_PROPOSED
  AMENDMENT_APPROVED
  AMENDMENT_REJECTED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String? // null for social providers
  fullName     String
  phone        String?
  provider     AuthProvider @default(LOCAL)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  memberships      Membership[]
  joinCodesCreated JoinCode[]           @relation("JoinCodeCreator")
  joinCodesUsed    JoinCode[]           @relation("JoinCodeUsedBy")
  passwordResets   PasswordResetToken[]
  auditLogs        AuditLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Business {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  isSolo      Boolean      @default(false) // "I work alone"
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  joinCodes   JoinCode[]
  cashUps     CashUp[]
  sales       Sale[]
  requests    Request[]
  amendments  Amendment[]
  auditLogs   AuditLog[]

  @@map("businesses")
}

// The role belongs to the membership, not the person.
// NOTE: "one Owner per business" needs a partial unique index.
model Membership {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  businessId    String         @db.Uuid
  role          MembershipRole
  isActive      Boolean        @default(true)
  joinedAt      DateTime       @default(now()) @db.Timestamptz(3)
  deactivatedAt DateTime?      @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  cashUps            CashUp[]    @relation("CashUpOwnerOfWork")
  cashUpsApproved    CashUp[]    @relation("CashUpApprover")
  salesEdited        SaleEdit[]
  requestsMade       Request[]   @relation("RequestRequester")
  requestsDecided    Request[]   @relation("RequestDecider")
  amendmentsProposed Amendment[] @relation("AmendmentProposer")
  amendmentsDecided  Amendment[] @relation("AmendmentDecider")

  @@unique([userId, businessId])
  @@index([businessId, role])
  @@map("memberships")
}

// Staff-only, single-use, expiring. Only the hash is stored.
model JoinCode {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  codeHash    String    @unique
  label       String // label given by the owner when created
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  usedById    String?   @db.Uuid
  revokedAt   DateTime? @db.Timestamptz(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy User     @relation("JoinCodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy    User?    @relation("JoinCodeUsedBy", fields: [usedById], references: [id], onDelete: Restrict)

  // Status (active / used / expired / revoked) is derived from usedAt, revokedAt, expiresAt.
  @@index([businessId, createdAt])
  @@map("join_codes")
}

model CashUp {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  membershipId String       @db.Uuid // the person doing the work
  status       CashUpStatus @default(OPEN)

  floatUsd      Decimal  @default(0) @db.Decimal(18, 2)
  floatLbp      Decimal  @default(0) @db.Decimal(18, 2)
  referenceRate Decimal? @db.Decimal(18, 2) // informational only, locked after approval

  // Timestamps (server-generated, UTC)
  openedAt       DateTime  @default(now()) @db.Timestamptz(3)
  countStartedAt DateTime? @db.Timestamptz(3) // when counting began (pilot metric)
  closedAt       DateTime? @db.Timestamptz(3) // set on submission
  approvedAt     DateTime? @db.Timestamptz(3)
  voidedAt       DateTime? @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  // Owner decision
  approvedById String? @db.Uuid
  selfApproved Boolean @default(false)
  returnReason String? // reason given on the last return to OPEN
  voidReason   String?

  // Snapshot computed by the server on submit (per-currency, no combined total)
  expectedUsd Decimal? @db.Decimal(18, 2)
  expectedLbp Decimal? @db.Decimal(18, 2)
  countedUsd  Decimal? @db.Decimal(18, 2)
  countedLbp  Decimal? @db.Decimal(18, 2)
  gapUsd      Decimal? @db.Decimal(18, 2) // counted - expected (signed)
  gapLbp      Decimal? @db.Decimal(18, 2)

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership Membership  @relation("CashUpOwnerOfWork", fields: [membershipId], references: [id], onDelete: Restrict)
  approvedBy Membership? @relation("CashUpApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  sales        Sale[]
  cashOuts     CashOut[]
  countEntries CountEntry[]
  requests     Request[]
  amendments   Amendment[]

  @@index([businessId, status])
  @@index([membershipId, status])
  @@index([businessId, openedAt])
  @@map("cash_ups")
}

model Sale {
  id         String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  cashUpId   String @db.Uuid
  saleNumber Int // sequential per cash-up, assigned by server

  status SaleStatus @default(DELIVERED)

  // Amounts (collected & change in the currency actually paid)
  businessAmount Decimal       @default(0) @db.Decimal(18, 2)
  deliveryFee    Decimal       @default(0) @db.Decimal(18, 2)
  tip            Decimal?      @db.Decimal(18, 2)
  discount       Decimal?      @db.Decimal(18, 2)
  totalCollected Decimal       @db.Decimal(18, 2)
  currency       Currency
  method         PaymentMethod
  changeGiven    Decimal?      @db.Decimal(18, 2)
  changeCurrency Currency?
  clientNumber   String? // required for TO_DELIVER sales (validated in service layer)
  note           String?

  // Flags shown to the owner at review
  mixedChange      Boolean @default(false) // change currency != payment currency
  amountDiffers    Boolean @default(false) // collected differs from the order on delivery
  isEdited         Boolean @default(false)
  deletionAwaiting Boolean @default(false) // locked while a delete request is pending

  cancelReason String?

  // Reliability: save once even if the request is sent twice
  idempotencyKey String? @db.Uuid

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp   CashUp   @relation(fields: [cashUpId], references: [id], onDelete: Restrict)

  edits            SaleEdit[]
  requests         Request[]
  amendmentChanges AmendmentChange[]

  @@unique([cashUpId, saleNumber])
  @@unique([businessId, idempotencyKey])
  @@index([cashUpId, status])
  @@index([businessId, clientNumber])
  @@map("sales")
}

// Every edit is logged with the old and new value.
model SaleEdit {
  id         String   @id @default(uuid()) @db.Uuid
  saleId     String   @db.Uuid
  editedById String   @db.Uuid
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  sale     Sale       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  editedBy Membership @relation(fields: [editedById], references: [id], onDelete: Restrict)

  @@index([saleId, createdAt])
  @@map("sale_edits")
}

model CashOut {
  id             String   @id @default(uuid()) @db.Uuid
  cashUpId       String   @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  currency       Currency
  reason         String
  idempotencyKey String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  cashUp CashUp @relation(fields: [cashUpId], references: [id], onDelete: Restrict)

  // Edits are recorded in AuditLog (entityType = CASH_OUT, action = CASHOUT_EDITED)
  @@unique([cashUpId, idempotencyKey])
  @@index([cashUpId])
  @@map("cash_outs")
}

// Counted notes by denomination. Saved as the user types.
model CountEntry {
  id           String   @id @default(uuid()) @db.Uuid
  cashUpId     String   @db.Uuid
  currency     Currency
  denomination Decimal  @db.Decimal(18, 2) // e.g. 1, 5, 100 (USD) or 1000, 100000 (LBP)
  quantity     Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  cashUp           CashUp            @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  amendmentChanges AmendmentChange[]

  @@unique([cashUpId, currency, denomination])
  @@map("count_entries")
}

// One open request per target is enforced by partial unique indexes.
model Request {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  type          RequestType
  status        RequestStatus @default(AWAITING_OWNER)
  reason        String
  requestedById String        @db.Uuid

  // Target: exactly one of these is set depending on `type`
  saleId   String? @db.Uuid // DELETE_SALE
  cashUpId String  @db.Uuid // always the cash-up it belongs to (also the target for VOID_CASHUP)

  decidedById    String?   @db.Uuid
  decisionReason String? // required when rejected
  selfApproved   Boolean   @default(false)
  decidedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp      CashUp      @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy Membership  @relation("RequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   Membership? @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@index([cashUpId, status])
  @@map("requests")
}

model Amendment {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String          @db.Uuid
  cashUpId   String          @db.Uuid // the original is never overwritten
  status     AmendmentStatus @default(AWAITING_APPROVAL)
  reason     String

  proposedById   String      @db.Uuid
  decidedById    String?     @db.Uuid // "the other party" approves
  decisionReason String?
  selfApproved   Boolean     @default(false)
  decidedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cashUp         CashUp      @relation(fields: [cashUpId], references: [id], onDelete: Restrict)
  proposedBy     Membership  @relation("AmendmentProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy      Membership? @relation("AmendmentDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  changes AmendmentChange[]

  @@index([businessId, status])
  @@index([cashUpId])
  @@map("amendments")
}

// One amendment can change several sale fields and counted notes.
model AmendmentChange {
  id          String              @id @default(uuid()) @db.Uuid
  amendmentId String              @db.Uuid
  kind        AmendmentChangeKind

  saleId   String? @db.Uuid
  field    String?
  oldValue String?
  newValue String?

  countEntryId String? @db.Uuid
  oldQuantity  Int?
  newQuantity  Int?

  amendment  Amendment   @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  countEntry CountEntry? @relation(fields: [countEntryId], references: [id], onDelete: Restrict)

  @@index([amendmentId])
  @@map("amendment_changes")
}

// Never updated or deleted. Enforce with a DB trigger / revoked privileges (see bottom of file).
model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  businessId String?         @db.Uuid
  actorId    String?         @db.Uuid // User who did it
  action     AuditAction
  entityType AuditEntityType
  entityId   String          @db.Uuid
  metadata   Json? // old/new values, reasons, etc. (no client numbers)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// RAW SQL TO ADD IN A MIGRATION (Prisma cannot express these)
// Run `prisma migrate dev --create-only`, then paste into the generated migration.sql
// ============================================================
//
// -- 1) One OWNER per business (v1)
// CREATE UNIQUE INDEX one_owner_per_business
//   ON memberships ("businessId") WHERE role = 'OWNER';
//
// -- 2) One OPEN cash-up per person per business
// CREATE UNIQUE INDEX one_open_cashup_per_member
//   ON cash_ups ("membershipId") WHERE status = 'OPEN';
//
// -- 3) One awaiting request per target
// CREATE UNIQUE INDEX one_open_request_per_sale
//   ON requests ("saleId") WHERE status = 'AWAITING_OWNER' AND "saleId" IS NOT NULL;
// CREATE UNIQUE INDEX one_open_request_per_cashup
//   ON requests ("cashUpId") WHERE status = 'AWAITING_OWNER' AND type = 'VOID_CASHUP';
//
// -- 4) Money sanity: no negatives
// ALTER TABLE sales ADD CONSTRAINT sales_non_negative CHECK (
//   "businessAmount" >= 0 AND "deliveryFee" >= 0 AND "totalCollected" >= 0
//   AND COALESCE(tip,0) >= 0 AND COALESCE(discount,0) >= 0 AND COALESCE("changeGiven",0) >= 0);
// ALTER TABLE cash_outs ADD CONSTRAINT cash_outs_positive CHECK (amount > 0);
//
// -- 5) Audit log is append-only
// CREATE OR REPLACE FUNCTION audit_log_immutable() RETURNS trigger AS $$
// BEGIN RAISE EXCEPTION 'audit_logs is append-only'; END; $$ LANGUAGE plpgsql;
// CREATE TRIGGER audit_logs_no_update BEFORE UPDATE OR DELETE ON audit_logs
//   FOR EACH ROW EXECUTE FUNCTION audit_log_immutable();
