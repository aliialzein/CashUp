@baseUrl = http://localhost:3000/api/v1
@businessId = 11111111-1111-4111-8111-111111111111
@staffUserId = 22222222-2222-4222-8222-222222222222
@managerUserId = 33333333-3333-4333-8333-333333333333
@ownerUserId = 88888888-8888-4888-8888-888888888888
@memberId = 99999999-9999-4999-8999-999999999999
@joinCodeId = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

### Create a business (no business header)
POST {{baseUrl}}/businesses
Content-Type: application/json
x-dev-user-id: {{ownerUserId}}

{
  "name": "CashUp Shop",
  "isSolo": false
}

###

### Read the current business
GET {{baseUrl}}/business
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

###

### Change solo mode
PATCH {{baseUrl}}/business/solo
Content-Type: application/json
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

{
  "isSolo": true
}

###

### List business members
GET {{baseUrl}}/business/members
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

###

### Deactivate a member
POST {{baseUrl}}/business/members/{{memberId}}/deactivate
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

###

### Replace the Manager
PUT {{baseUrl}}/business/manager
Content-Type: application/json
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

{
  "memberId": "{{memberId}}"
}

###

### Create a Staff join code
# @name createJoinCode
POST {{baseUrl}}/business/join-codes
Content-Type: application/json
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

{
  "maxUses": 5,
  "expiresInDays": 7
}

###

### List join codes (codes and hashes are never returned)
GET {{baseUrl}}/business/join-codes
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

###

### Revoke a join code
POST {{baseUrl}}/business/join-codes/{{joinCodeId}}/revoke
x-dev-user-id: {{ownerUserId}}
x-dev-business-id: {{businessId}}

###

### Redeem a join code (no business header)
POST {{baseUrl}}/join-codes/redeem
Content-Type: application/json
x-dev-user-id: {{staffUserId}}

{
  "code": "23456789ABCD"
}

###

### Open a Staff cash-up
# @name openCashUp
POST {{baseUrl}}/cash-ups
Content-Type: application/json
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "floatUsd": "20.00",
  "floatLbp": "0.00"
}

###

@cashUpId = {{openCashUp.response.body.data.id}}

### Paid-now sale
# @name paidNowSale
POST {{baseUrl}}/cash-ups/{{cashUpId}}/sales
Content-Type: application/json
Idempotency-Key: 44444444-4444-4444-8444-444444444444
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "status": "DELIVERED",
  "businessAmount": "12.00",
  "deliveryFee": "0.00",
  "totalCollected": "12.00",
  "currency": "USD",
  "method": "CASH"
}

###

### To-deliver sale
# @name deliverySale
POST {{baseUrl}}/cash-ups/{{cashUpId}}/sales
Content-Type: application/json
Idempotency-Key: 55555555-5555-4555-8555-555555555555
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "status": "TO_DELIVER",
  "businessAmount": "500000.00",
  "deliveryFee": "0.00",
  "totalCollected": "500000.00",
  "currency": "LBP",
  "method": "CASH",
  "clientNumber": "+961123456"
}

###

@deliverySaleId = {{deliverySale.response.body.data.saleId}}

### Confirm delivery
POST {{baseUrl}}/cash-ups/{{cashUpId}}/sales/{{deliverySaleId}}/confirm-delivery
Content-Type: application/json
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "totalCollected": "500000.00",
  "currency": "LBP",
  "method": "CASH"
}

###

### Cancel an uncollected delivery sale
# @name cancelableSale
POST {{baseUrl}}/cash-ups/{{cashUpId}}/sales
Content-Type: application/json
Idempotency-Key: 66666666-6666-4666-8666-666666666666
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "status": "TO_DELIVER",
  "businessAmount": "7.00",
  "deliveryFee": "0.00",
  "totalCollected": "7.00",
  "currency": "USD",
  "method": "CASH",
  "clientNumber": "+961123456"
}

###

@cancelableSaleId = {{cancelableSale.response.body.data.saleId}}

POST {{baseUrl}}/cash-ups/{{cashUpId}}/sales/{{cancelableSaleId}}/cancel
Content-Type: application/json
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "reason": "Customer cancelled"
}

###

### Record cash-out
# @name recordCashOut
POST {{baseUrl}}/cash-ups/{{cashUpId}}/cash-outs
Content-Type: application/json
Idempotency-Key: 77777777-7777-4777-8777-777777777777
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "amount": "2.00",
  "currency": "USD",
  "reason": "Shop supplies"
}

###

@cashOutId = {{recordCashOut.response.body.data.cashOut.id}}

### Cancel a cash-out
POST {{baseUrl}}/cash-ups/{{cashUpId}}/cash-outs/{{cashOutId}}/cancel
Content-Type: application/json
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "reason": "Returned purchase"
}

###

### Replace the count set
PUT {{baseUrl}}/cash-ups/{{cashUpId}}/count
Content-Type: application/json
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

{
  "lines": [
    { "currency": "USD", "denomination": "1.00", "quantity": 3 },
    { "currency": "USD", "denomination": "5.00", "quantity": 1 },
    { "currency": "LBP", "denomination": "1000.00", "quantity": 10 }
  ]
}

###

### Reviewers see open summaries without amount details
GET {{baseUrl}}/review/cash-ups/open
x-dev-user-id: {{managerUserId}}
x-dev-business-id: {{businessId}}

###

### Submit the Staff cash-up
POST {{baseUrl}}/cash-ups/{{cashUpId}}/submit
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

###

### Manager submitted list
GET {{baseUrl}}/review/cash-ups/submitted
x-dev-user-id: {{managerUserId}}
x-dev-business-id: {{businessId}}

###

### Manager review detail
GET {{baseUrl}}/review/cash-ups/{{cashUpId}}
x-dev-user-id: {{managerUserId}}
x-dev-business-id: {{businessId}}

###

### Return to Staff for changes
POST {{baseUrl}}/review/cash-ups/{{cashUpId}}/return
Content-Type: application/json
x-dev-user-id: {{managerUserId}}
x-dev-business-id: {{businessId}}

{
  "reason": "Please verify the count before resubmitting."
}

###

### Submit again after the count step is implemented
POST {{baseUrl}}/cash-ups/{{cashUpId}}/submit
x-dev-user-id: {{staffUserId}}
x-dev-business-id: {{businessId}}

###

### Manager approves the submitted cash-up
POST {{baseUrl}}/review/cash-ups/{{cashUpId}}/approve
x-dev-user-id: {{managerUserId}}
x-dev-business-id: {{businessId}}
