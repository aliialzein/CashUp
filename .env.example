# Pooled connection for the application runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
# Direct connection (port 5432) for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Disposable integration-test database; the database name must contain "test".
TEST_DATABASE_URL=postgresql://cashup_test:cashup_test@localhost:55432/cashup_test

# Server-only transactional email. EMAIL_FROM must use a verified Resend domain.
RESEND_API_KEY="re_your_actual_key"
EMAIL_FROM="CashUp <onboarding@resend.dev>"
RESET_CODE_SECRET="paste_generated_secret_here"
